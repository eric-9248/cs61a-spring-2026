(define (line x l)
    (if (zero? (length l))
    ()
    (begin
      (define y (car l))
      (goto (- (* 3 (car y)) 300) (- 200 (* 3 x)))
      (pd)
      (goto (- (* 3 (car (cdr y))) 300) (- 200 (* 3 x)))
      (pu)
      (line x (cdr l))
      )
    )
  )
(define (lines l)
  (if (zero? (length l))
    ()
    (begin
      (define x (car (car l)))
      (line x (cdr (car l)))
      (lines (cdr l))
      )
    )
  )

